# ===================================================
# Grand Hotel De Djokja - Environment Variables Guide
# ===================================================

# 1. Konfigurasi Database Turso (Wajib untuk Vercel / Remote DB)
# Salin kedua variabel ini ke Vercel: Project Settings -> Environment Variables
TURSO_DATABASE_URL=libsql://your-database-name-your-username.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# 2. Secret Session / JWT (Opsional, sudah ada nilai bawaan)
SESSION_SECRET=grand-hotel-de-djokja-heritage-secret-key-2027
